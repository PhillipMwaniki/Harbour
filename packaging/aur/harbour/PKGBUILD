# Maintainer: Phillip Mwaniki <mwanikiphillip@gmail.com>
#
# Builds from the tagged source. The binary package is `harbour-bin`. Both are
# published by .github/workflows/aur.yml when a release is published, and this
# one is also built from the checkout on every push to master by ci.yml, so a
# release never ships a PKGBUILD that does not build.

pkgname=harbour
pkgver=0.1.0
pkgrel=1
pkgdesc="SSH client, terminal and SFTP file manager in one window"
arch=('x86_64' 'aarch64')
url="https://github.com/PhillipMwaniki/Harbour"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg' 'openssl' 'gcc-libs' 'glibc')
makedepends=('cargo' 'nodejs' 'pnpm')
provides=("${pkgname}=${pkgver}")
conflicts=('harbour-bin')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "Harbour-${pkgver}"
  # Everything the build needs is fetched here, so build() runs offline.
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "Harbour-${pkgver}"
  export CARGO_TARGET_DIR=target
  pnpm exec vite build
  # tauri::generate_context! reads ../dist at compile time, hence the order.
  cargo build --release --frozen --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "Harbour-${pkgver}"
  install -Dm755 target/release/harbour "${pkgdir}/usr/bin/harbour"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm644 src-tauri/icons/32x32.png "${pkgdir}/usr/share/icons/hicolor/32x32/apps/harbour.png"
  install -Dm644 src-tauri/icons/128x128.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/harbour.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/harbour.png"
  install -Dm644 src-tauri/icons/icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/harbour.png"

  install -dm755 "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/harbour.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Harbour
Comment=SSH client, terminal and SFTP file manager
Exec=harbour
Icon=harbour
Terminal=false
Categories=Development;Network;RemoteAccess;
Keywords=ssh;sftp;terminal;
EOF
}
