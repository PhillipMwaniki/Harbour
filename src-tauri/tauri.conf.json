{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbour",
  "version": "0.2.0",
  "identifier": "com.harbour.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harbour",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SSH client, terminal and SFTP file manager",
    "longDescription": "Harbour is a cross-platform SSH client that combines a terminal, a session manager and an SFTP file manager in a single window.",
    "copyright": "Copyright (c) 2026 Harbour contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "librsvg2"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/PhillipMwaniki/Harbour/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NkQ1NTJBMDA2RURGMkQKUldRdDMyNEFLbFZ0V2NjOGpHVG9SQXFVZ0NkY09HMVNIMzlVby94TzdjY2dpQ0paS3YrZlFkMCsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
